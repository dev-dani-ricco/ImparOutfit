NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://impar:impar@localhost:5432/imparoutfit
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false
JWT_SECRET=change-me-with-a-long-random-secret
CORS_ORIGIN=http://localhost:8081
TRUST_PROXY_HOPS=0
# Production requires an explicit durable private path. Never serve this directory statically.
MEDIA_ROOT=./private/media
# Private prompt/knowledge payloads referenced by private://... live here. Use a path outside Git in production.
IMPAR_PRIVATE_CONTENT_ROOT=./private/content
# Production containers should bind externally; local development may keep 127.0.0.1.
HOST=127.0.0.1
# For local-only development, use PGLite instead of DATABASE_URL:
# PGLITE_DATA_DIR=./private/local-pgdata
IMPAR_ANALYSIS_SUPERVISOR_ENABLED=true
IMPAR_ANALYSIS_POLL_MS=1500
IMPAR_EXECUTION_PRINCIPAL_ID=replace-with-bootstrap-principal-id
IMPAR_DEFAULT_METHODOLOGY_KEY=IMPAR_TECHNICAL_BOOTSTRAP
OMNIROUTE_BASE_URL=http://127.0.0.1:20128
OMNIROUTE_API_KEY=replace-with-scoped-local-key
IMPAR_ANALYSIS_MODEL=openai/gpt-oss-120b
IMPAR_ANALYSIS_MAX_TOKENS=1400
IMPAR_ANALYSIS_PROVIDER_TIMEOUT_MS=110000
# Local AI gateway. Keep real API keys out of Git; use the local launcher or secret manager.
IMPAR_AI_GATEWAY_URL=http://127.0.0.1:20128/v1
IMPAR_AI_MODEL=openrouter/nex-agi/nex-n2.5-mini:free

# Optional external Dani Ricco knowledge service. This domain is isolated from TI Broker CORE.
DANI_KNOWLEDGE_BASE_URL=
DANI_KNOWLEDGE_RUNTIME_TOKEN=
DANI_KNOWLEDGE_RUNTIME_TIMEOUT_MS=8000

# Bootstrap must reference Dani-owned published knowledge; do not point this at TI Broker CORE.
DANI_KNOWLEDGE_BOOTSTRAP_REF=dani-knowledge://<project-id>/<knowledge-id>
DANI_KNOWLEDGE_BOOTSTRAP_HASH=<sha256>
