{
    "cli": {
        "version": ">= 21.1.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "channel": "development"
        },
        "preview": {
            "distribution": "internal",
            "env": {
                "REQUIRE_DISTRIBUTED_API": "true"
            },
            "channel": "preview"
        },
        "production": {
            "autoIncrement": true,
            "env": {
                "REQUIRE_DISTRIBUTED_API": "true"
            },
            "channel": "production"
        }
    },
    "submit": {
        "production": {}
    }
}
