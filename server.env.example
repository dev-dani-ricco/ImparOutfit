# Copie este arquivo para .env.server e substitua todos os valores CHANGE_ME.
POSTGRES_USER=impar
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=imparoutfit

JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# Origens web permitidas; aplicativos nativos não dependem de CORS.
CORS_ORIGIN=http://localhost:8081
TRUST_PROXY_HOPS=1

# Compose usa um volume privado durável para mídia, nunca servido como diretório público.
